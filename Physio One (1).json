    {
      "parameters": {
        "jsCode": "const raw = ($input.item.json.output || '').trim();\n\n// Safety net: unwrap JSON if agent accidentally wraps\nif (raw.startsWith('{') || raw.startsWith('```')) {\n  const stripped = raw.replace(/^```(?:json)?\\s*/,'').replace(/\\s*```$/,'').trim();\n  try {\n    const parsed = JSON.parse(stripped);\n    if (parsed.reply && typeof parsed.reply === 'string') {\n      const inner = parsed.reply.trim();\n      if (inner.startsWith('{')) {\n        try {\n          const inner2 = JSON.parse(inner);\n          if (inner2.reply) {\n            const text = inner2.reply.replace(/\\\\n/g, '\\n').trim();\n            return [{ json: { reply: text } }];\n          }\n        } catch(e2) {}\n      }\n      const text = inner.replace(/\\\\n/g, '\\n').trim();\n      return [{ json: { reply: text } }];\n    }\n  } catch(e) {}\n}\n\n// Normal plain text — fix literal \\n → real newlines\nif (raw && raw.toLowerCase() !== 'null' && raw !== '') {\n  const text = raw.replace(/\\\\n/g, '\\n').trim();\n  return [{ json: { reply: text } }];\n}\n\nreturn [];"
      },
